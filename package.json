{
  "name": "tabelas-whatsapp",
  "version": "1.3.0",
  "description": "Automacao local para envio de mensagens em massa por etiqueta do WhatsApp Business",
  "author": "Vanessa",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:nsis": "electron-builder --win --x64",
    "dist:win:msi": "electron-builder --win msi:x64"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.1.0",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.felipechessa.multienvio",
    "productName": "Disparo em Massa",
    "copyright": "Copyright © 2024 Felipe Chessa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "package-lock.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Disparo.em.Massa.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Disparo em Massa",
      "uninstallDisplayName": "Disparo em Massa",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Disparo em Massa",
      "upgradeCode": "{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
    },
    "publish": {
      "provider": "github",
      "owner": "FelipeChessa",
      "repo": "multienvio"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
