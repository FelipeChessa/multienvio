{
  "name": "tabelas-whatsapp",
  "version": "1.6.3",
  "description": "MultiEnvio",
  "author": "Chessa.com.br",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "app:teste": "electron . --dados-do-projeto",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:nsis": "electron-builder --win --x64"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^25.0.0",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.felipechessa.multienvio",
    "productName": "MultiEnvio",
    "copyright": "Copyright © 2024 Felipe Chessa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "package-lock.json"
    ],
    "extraResources": [],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MultiEnvio.Setup.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiEnvio",
      "uninstallDisplayName": "MultiEnvio",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "FelipeChessa",
      "repo": "multienvio",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@7.6.6": true,
    "electron@44.10.2": true
  }
}
